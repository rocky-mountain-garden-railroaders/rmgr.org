{
  "name": "rmgr-vue3",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetchCalendarIcs.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore && eslint .",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "ical.js": "^2.2.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.12",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-vue-devtools": "^7.7.10",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  }
}
